{
  "name": "delta-comic-plugin-jmcomic",
  "private": true,
  "description": "禁漫天堂的 Delta Comic v3 插件与 TypeScript SDK",
  "repository": {
    "type": "git",
    "url": "https://github.com/delta-comic/jmcomic-sdk.git"
  },
  "type": "module",
  "scripts": {
    "branch:develop": "node ./script/release-branches.mts develop",
    "branch:develop:dry-run": "node ./script/release-branches.mts develop --dry-run",
    "build": "vp run -t @delta-comic/plugin-jmcomic#build",
    "check": "vp check",
    "dev": "vp run --filter @delta-comic/plugin-jmcomic dev",
    "lib-build": "vp run --filter jmcomic-sdk build",
    "release": "vp exec semantic-release",
    "release:dry-run": "vp exec semantic-release --dry-run",
    "release:preview": "node ./script/release-branches.mts preview",
    "release:preview:dry-run": "node ./script/release-branches.mts preview --dry-run",
    "release:stable": "node ./script/release-branches.mts stable",
    "release:stable:dry-run": "node ./script/release-branches.mts stable --dry-run",
    "test": "vp test",
    "test:coverage": "vp test run --coverage",
    "test:type": "vp test typecheck",
    "typecheck": "vp run -r typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@semantic-release/commit-analyzer": "catalog:",
    "@semantic-release/github": "catalog:",
    "@semantic-release/release-notes-generator": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "semantic-release": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  },
  "packageManager": "pnpm@12.0.0-rc.3"
}